---
const points = [
  "Custom software development for the real estate sector and beyond.",
  "Our own proptech products, built and operated in-house.",
  "Cloud-native architecture engineered to scale from day one.",
];
---

<section id="about" class="about">
  <div class="wrap about-grid">
    <div class="about-head" data-reveal>
      <p class="eyebrow">Who we are</p>
      <h2 class="section-title">
        A software company engineering the proptech stack.
      </h2>
    </div>

    <div class="about-body">
      <p class="lead" data-reveal style="--delay:80ms">
        Sirius Platforms, Inc. is a Delaware-based software development company.
        We build digital products for the real estate industry and partner with
        businesses to deliver reliable, scalable software — from architecture to
        production.
      </p>
      <p class="about-note" data-reveal style="--delay:160ms">
        Named after the brightest star in the night sky, we aim to be a fixed point
        of engineering quality our clients can navigate by.
      </p>

      <ul class="about-points">
        {points.map((p, i) => (
          <li data-reveal style={`--delay:${240 + i * 90}ms`}>
            <span class="dot" aria-hidden="true"></span>
            {p}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .about-note {
    margin-top: 1.4rem;
    color: var(--text-faint);
    font-style: italic;
    font-family: var(--font-display);
    font-size: 1.12rem;
    line-height: 1.6;
    max-width: 46ch;
  }
  .about-points {
    list-style: none;
    margin: 2.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .about-points li {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    color: var(--text-dim);
    font-size: 1.02rem;
  }
  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    margin-top: 0.1rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--glow);
    transform: translateY(0.3em);
  }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
