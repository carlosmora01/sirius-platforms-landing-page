---
const services = [
  {
    title: "Custom Software Development",
    desc: "Tailored web and mobile products, engineered to your requirements from architecture to delivery.",
    icon: `<path d="m8 6-6 6 6 6" /><path d="m16 6 6 6-6 6" />`,
  },
  {
    title: "Cloud Architecture & DevOps",
    desc: "Secure, scalable AWS infrastructure with automated CI/CD and observability built in.",
    icon: `<path d="M17.5 19a4.5 4.5 0 0 0 .5-8.98A6 6 0 0 0 6.2 9.5 4 4 0 0 0 7 19h10.5Z" />`,
  },
  {
    title: "Mobile Applications",
    desc: "Cross-platform apps with Flutter — one codebase that ships to every device.",
    icon: `<rect x="7" y="3" width="10" height="18" rx="2.5" /><path d="M11 18h2" />`,
  },
  {
    title: "Product Engineering",
    desc: "From discovery and UX through launch, iteration and ongoing support.",
    icon: `<circle cx="12" cy="12" r="3.2" /><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1" />`,
  },
];
---

<section id="capabilities" class="services">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Capabilities</p>
      <h2 class="section-title">From idea to production, end to end.</h2>
    </div>

    <div class="svc-grid">
      {services.map((s, i) => (
        <article class="card svc" data-reveal style={`--delay:${i * 80}ms`}>
          <span class="svc-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none"
                 stroke="currentColor" stroke-width="1.6"
                 stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
          </span>
          <h3 class="svc-title">{s.title}</h3>
          <p class="svc-desc">{s.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .svc-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2.2vw, 1.4rem);
  }
  .svc {
    padding: 1.7rem 1.5rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .svc-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--border-strong);
  }
  .svc-title {
    font-size: 1.18rem;
    font-weight: 500;
    line-height: 1.25;
  }
  .svc-desc {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 940px) {
    .svc-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .svc-grid { grid-template-columns: 1fr; }
  }
</style>
