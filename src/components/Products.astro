---
---

<section id="products" class="products">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <p class="eyebrow">What we build</p>
      <h2 class="section-title">Products for the way real estate works today.</h2>
    </div>

    <div class="prod-grid">
      <!-- Featured: Envivienda.com -->
      <article class="card prod prod-featured" data-reveal style="--delay:60ms">
        <div class="prod-content">
          <div class="prod-brand">
            <img class="prod-logo" src="/logo.png" width="46" height="46"
                 alt="Envivienda logo" loading="lazy" decoding="async" />
            <p class="prod-tag"><span class="num">01</span> Property Portal</p>
          </div>
          <h3 class="prod-title">Envivienda.com</h3>
          <p class="prod-desc">
            A real estate portal where buyers and renters search, compare and find
            their next property — fast, intuitive and built to scale to thousands of
            listings.
          </p>
          <div class="prod-meta">
            <span class="chip">Search &amp; discovery</span>
            <span class="chip">Listings at scale</span>
            <span class="chip">Mobile-first</span>
          </div>
          <span class="prod-link">envivienda.com <span class="ext">↗</span></span>
        </div>

        <!-- decorative search mock -->
        <div class="mock mock-search" aria-hidden="true">
          <div class="mock-bar">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7" /><path d="m20 20-3-3" />
            </svg>
            <span>Apartments in the city center…</span>
          </div>
          <div class="mock-cards">
            <span></span><span></span><span></span>
          </div>
        </div>
      </article>

      <!-- Real Estate CRM -->
      <article class="card prod prod-crm" data-reveal style="--delay:160ms">
        <div class="prod-content">
          <p class="prod-tag"><span class="num">02</span> Agency CRM</p>
          <h3 class="prod-title">Real Estate CRM</h3>
          <p class="prod-desc">
            A CRM purpose-built for real estate agencies to manage listings, leads
            and clients in one connected workspace.
          </p>
          <div class="prod-meta">
            <span class="chip">Lead pipeline</span>
            <span class="chip">Listings</span>
          </div>
        </div>

        <!-- decorative pipeline mock -->
        <div class="mock mock-pipe" aria-hidden="true">
          <div class="col"><i></i><i></i></div>
          <div class="col"><i></i></div>
          <div class="col"><i></i><i></i></div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .prod-grid {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: 1.32fr 1fr;
    gap: clamp(1.1rem, 2.4vw, 1.6rem);
  }

  .prod {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    min-height: 360px;
  }

  .prod-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.7em;
  }
  .num {
    color: var(--text-faint);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 0.15em 0.5em;
    font-size: 0.66rem;
  }
  .prod-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .prod-logo {
    width: 46px;
    height: 46px;
    object-fit: contain;
    padding: 8px;
    border-radius: 12px;
    background: var(--accent-soft);
    border: 1px solid var(--border-strong);
    box-shadow: 0 0 26px -8px var(--glow);
  }
  .prod-title {
    margin-top: 1rem;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    font-weight: 500;
  }
  .prod-desc {
    margin-top: 0.9rem;
    color: var(--text-dim);
    max-width: 42ch;
    line-height: 1.7;
  }
  .prod-meta {
    margin-top: 1.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .chip {
    font-size: 0.78rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 999px;
    padding: 0.36em 0.85em;
  }
  .prod-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    letter-spacing: 0.05em;
    color: var(--text);
  }
  .ext { color: var(--accent); transition: transform 0.35s var(--ease); }
  .prod-featured:hover .ext { transform: translate(2px, -2px); }

  /* ---- decorative mocks ---- */
  .mock {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: linear-gradient(180deg, rgba(134, 103, 255, 0.06), transparent);
    padding: 1rem;
  }
  .mock-search { display: grid; gap: 0.8rem; }
  .mock-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-dim);
    font-size: 0.86rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.6rem 0.95rem;
    background: rgba(4, 6, 14, 0.6);
  }
  .mock-bar svg { color: var(--accent); flex: none; }
  .mock-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
  .mock-cards span {
    height: 64px;
    border-radius: 10px;
    background:
      linear-gradient(180deg, rgba(160, 140, 255, 0.16), rgba(160, 140, 255, 0.03));
    border: 1px solid var(--border);
    position: relative;
  }
  .mock-cards span::after {
    content: "";
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    height: 6px;
    border-radius: 3px;
    background: var(--border-strong);
  }

  .mock-pipe { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7rem; }
  .mock-pipe .col { display: grid; gap: 0.55rem; align-content: start; }
  .mock-pipe i {
    height: 30px;
    border-radius: 7px;
    background: linear-gradient(180deg, rgba(160, 140, 255, 0.14), rgba(160, 140, 255, 0.02));
    border: 1px solid var(--border);
  }
  .mock-pipe .col:nth-child(1) i { border-left: 2px solid var(--accent-bright); }
  .mock-pipe .col:nth-child(2) i { border-left: 2px solid var(--accent); }
  .mock-pipe .col:nth-child(3) i { border-left: 2px solid var(--accent-2); }

  @media (max-width: 820px) {
    .prod-grid { grid-template-columns: 1fr; }
    .prod { min-height: 0; }
  }
</style>
